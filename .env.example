# Configurações de Ambiente - BioCiclo IA

# Chave de API do Roboflow (obtenha em https://app.roboflow.com/settings/api)
ROBOFLOW_API_KEY=sua_chave_aqui

# Limiar padrão de confiança da detecção (0.0 a 1.0)
CONFIDENCE_THRESHOLD=0.50

# Caminho para pesos customizados (opcional)
MODEL_PATH=models/weights/best.pt
